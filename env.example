# Copy this file to .env and fill in real values locally / in your
# deployment platform's secret manager. NEVER commit real secrets —
# .env and .env.* are already git-ignored (see .gitignore); only this
# .env.example file (placeholders only) is meant to be committed.

# --- Supabase (required for every authenticated request) ---
# Project Settings → API in your Supabase dashboard.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Project Settings → API → "service_role" secret. Server-side only —
# never expose this in frontend code or commit it to Git.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# --- Vite (frontend build-time copies of the public Supabase values) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# --- OpenAI (optional — only required for the AI retail-intelligence
# agent-assistant feature; the rest of the system works without it) ---
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-4o-mini
